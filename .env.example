# Final Thesis API Configuration Template
# Copy to .env and adjust local values. Never commit actual credentials.

# Application environment: development | staging | production
APP_ENV=development

# Service identifier
APP_NAME=final-thesis-api

# PostgreSQL connection string (Supabase staging or local postgres)
# Example Supabase pooled connection for project 'klaukirnadifltzhqidg' (port 6543 / Supavisor, Singapore):
# DATABASE_URL=postgresql://postgres.klaukirnadifltzhqidg:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173

# Optional: Regular expression for preview origins (e.g. Vercel preview branches)
# CORS_ORIGIN_REGEX=https://.*final-thesis.*\.vercel\.app

# Optional: Commit SHA override (Render populates RENDER_GIT_COMMIT automatically)
APP_REVISION=

# Reserved for future phases (backend server-side only; never expose to frontend)
OPENAI_API_KEY=

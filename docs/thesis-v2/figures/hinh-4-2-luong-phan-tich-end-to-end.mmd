flowchart TB
    Q(["<b>Câu hỏi tiếng Việt</b>"])
    subgraph PRE ["Chuẩn bị"]
        direction LR
        P["<b>1. Kiểm tra phạm vi,<br/>phân tích câu hỏi, lập kế hoạch</b><br/>(khóa kế hoạch trước khi truy xuất)"]
        T["<b>2. Công cụ tính toán</b><br/>tính dữ kiện kèm công thức<br/>và mã nguồn"]
        G["<b>3. Tín hiệu và<br/>phát hiện liên tầng</b>"]
        P --> T --> G
    end
    subgraph WRI ["Viết và kiểm tra"]
        direction LR
        W["<b>4. Chuyên viên viết nhận định</b><br/>(mỗi câu trích dẫn một dữ kiện)"]
        V["<b>5. Kiểm tra câu</b><br/>loại bỏ độc lập từng<br/>câu vi phạm"]
        A["<b>6. Tổng hợp báo cáo</b><br/>ghép theo khối, kiểm tra cấu trúc"]
        C["<b>7. Phản biện và sửa đổi</b><br/>(tối đa 2 vòng)"]
        W --> V --> A --> C
        C -.->|"câu cần sửa"| W
    end
    O(["<b>Báo cáo và nhật ký từng bước</b>"])
    Q --> PRE
    PRE --> WRI
    WRI --> O

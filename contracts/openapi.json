{
  "openapi": "3.1.0",
  "info": {
    "title": "Hierarchical Financial Multi-Agent Analysis API",
    "version": "1.2.0",
    "description": "Reference API for analysis of Vietnamese listed banks. The runtime supports single-period provider-backed analysis, deterministic acceptance and bounded semantic review. Macro is activated only when the accepted provider declares the requested capability and observations; the current Gold case study has no accepted macro data. Multi-period requests remain unsupported."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns operational liveness status of the API service.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "thesis-financial-api"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Readiness probe",
        "description": "Validates database connectivity and analytical readiness.",
        "responses": {
          "200": {
            "description": "Infrastructure is ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ready"
                    },
                    "database": {
                      "type": "string",
                      "example": "connected"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "summary": "Submit analysis query (synchronous)",
        "description": "Freezes a query-derived plan before retrieval, invokes only required provider-declared capabilities, synthesizes canonical claims, runs Stage-1, then configured semantic critique and at most two targeted revision rounds. Unsupported scope or unavailable configuration fails closed. Offline tests do not establish live provider readiness.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis generated with hierarchical critique and evidence trail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid analytical query or scope parameters"
          },
          "500": {
            "description": "Internal analytical engine or verification failure"
          }
        }
      }
    },
    "/api/analyze/stream": {
      "post": {
        "summary": "Stream analysis session events (SSE)",
        "description": "Streams observable transitions from the same runtime as synchronous analysis, including actual review/revision transitions. Ends with REPORT_READY for an accepted report or RUN_BLOCKED for an error. Events omit private reasoning.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream emitting serialized AnalysisSessionEvent frames",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Chronological stream of SSE events formatted as event: <type>\\ndata: <json>\\n\\n. Payload matches AnalysisSessionEvent schema."
                }
              }
            }
          },
          "400": {
            "description": "Invalid analytical query or scope parameters"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural language analytical question in Vietnamese or English",
            "example": "Phân tích ACB tại 2024_Q4 dựa trên ROE và NPL."
          },
          "target_ticker": {
            "type": "string",
            "description": "Primary bank ticker symbol under investigation",
            "example": "ACB"
          },
          "peer_tickers": {
            "type": "array",
            "description": "Optional list of peer comparison bank tickers",
            "items": {
              "type": "string"
            },
            "example": [
              "TCB",
              "MBB"
            ]
          },
          "period": {
            "type": "string",
            "description": "One supported snapshot period (for example 2024_Q4). Compact or expanded multi-period ranges fail with multi_period_unsupported; historical trend runners do not imply support in this API.",
            "example": "2024_Q4"
          }
        },
        "example": {
          "query": "So sánh ROE và NPL của ACB với MBB, TCB, VCB và VPB tại 2024_Q4.",
          "target_ticker": "ACB",
          "peer_tickers": [
            "ACB",
            "MBB",
            "TCB",
            "VCB",
            "VPB"
          ],
          "period": "2024_Q4"
        }
      },
      "AnalysisPlan": {
        "type": "object",
        "required": [
          "plan_id",
          "query",
          "required_capabilities",
          "dataset_snapshot_id"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "example": "plan-2024-acb-001"
          },
          "query": {
            "type": "string"
          },
          "target_ticker": {
            "type": "string",
            "nullable": true,
            "example": "ACB"
          },
          "peer_tickers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "TCB",
              "MBB"
            ]
          },
          "period": {
            "type": "string",
            "example": "2024_Q4"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "macro",
                "sector",
                "company"
              ]
            },
            "example": [
              "company",
              "sector"
            ]
          },
          "applicable_links": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "peer_comparison",
                "macro_transmission",
                "cross_level_stress"
              ]
            },
            "example": [
              "peer_comparison"
            ]
          },
          "dataset_snapshot_id": {
            "type": "string",
            "example": "snap-2024-q4-v1"
          },
          "rationale": {
            "type": "string"
          },
          "known_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MacroContext": {
        "type": "object",
        "properties": {
          "sbv_policy_rate": {
            "type": "number",
            "example": 4.5
          },
          "system_credit_growth": {
            "type": "number",
            "example": 15.08
          },
          "interest_rate_trend": {
            "type": "string",
            "example": "Accommodative monetary policy by SBV supporting private credit recovery"
          },
          "source": {
            "type": "string",
            "example": "SBV Annual Direction 2024"
          }
        }
      },
      "SectorBenchmark": {
        "type": "object",
        "required": [
          "sector"
        ],
        "properties": {
          "sector": {
            "type": "string",
            "example": "Banking"
          },
          "peer_median_roe": {
            "type": "number",
            "example": 18.2
          },
          "peer_median_nim": {
            "type": "number",
            "example": 3.65
          },
          "peer_median_npl": {
            "type": "number",
            "example": 1.62
          },
          "peer_median_cir": {
            "type": "number",
            "example": 33.4
          },
          "peer_median_casa": {
            "type": "number",
            "example": 28.5
          },
          "peer_median_car": {
            "type": "number",
            "example": 11.8
          },
          "peer_median_ldr": {
            "type": "number",
            "example": 78.4
          },
          "peer_median_roa": {
            "type": "number",
            "description": "Accepted peer median in percentage units, only when requested and supported."
          },
          "peer_median_npl_g35": {
            "type": "number",
            "description": "Accepted peer median for bank.npl_g35; exact current metric suffix. peer_median_npl is retained as a legacy alias."
          },
          "peer_median_llr_coverage": {
            "type": "number",
            "description": "Accepted peer median for bank.llr_coverage."
          },
          "peer_universe_id": {
            "type": "string",
            "description": "Provider-declared peer universe identity."
          },
          "aggregation_method": {
            "type": "string",
            "description": "Versioned provider aggregation method; currently peer_median_v1."
          },
          "requested_peer_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Ordered requested member set defining benchmark identity and claim scope."
          },
          "eligible_peer_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Ordered members supplying accepted numeric input observations."
          },
          "requested_denominator": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of requested members."
          },
          "eligible_denominator": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of accepted numeric member inputs used by the aggregate."
          },
          "missing_members": {
            "type": "array",
            "description": "Requested members excluded from the numeric denominator, each with an explicit reason.",
            "items": {
              "type": "object",
              "required": [
                "entity_id",
                "reason"
              ],
              "properties": {
                "entity_id": {
                  "type": "string"
                },
                "observation_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "validation_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "benchmarks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeerBenchmarkRecord"
            },
            "description": "Authoritative per-metric benchmark records for new peer reports. Shared legacy metadata is emitted only when identical across all records."
          }
        },
        "description": "Peer medians for the explicitly requested case-study set. New provider-backed reports populate benchmarks with metadata per metric. Legacy scalar medians remain for compatibility; shared top-level metadata must be omitted when membership or denominator differs across records. Older saved reports may omit these additive fields."
      },
      "CompanyInsight": {
        "type": "object",
        "required": [
          "ticker",
          "assessment"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "example": "ACB"
          },
          "roe": {
            "type": "number",
            "example": 21.4
          },
          "nim": {
            "type": "number",
            "example": 3.82
          },
          "npl": {
            "type": "number",
            "example": 1.21
          },
          "cir": {
            "type": "number",
            "example": 31.8
          },
          "casa": {
            "type": "number",
            "example": 23.2
          },
          "car": {
            "type": "number",
            "example": 12.8
          },
          "ldr": {
            "type": "number",
            "example": 82.5
          },
          "assessment": {
            "type": "string"
          }
        }
      },
      "CritiqueItem": {
        "type": "object",
        "required": [
          "dimension",
          "finding",
          "confidence"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "example": "NPL vs Sector Margin Pressure"
          },
          "finding": {
            "type": "string",
            "example": "ACB preserved retail asset quality despite elevated consumer delinquency across tier-2 peers."
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.94
          },
          "evidence_ref": {
            "type": "string",
            "example": "ACB-FY24-AR-p42"
          }
        }
      },
      "AtomicClaim": {
        "type": "object",
        "required": [
          "claim_id",
          "capability",
          "statement",
          "evidence_refs",
          "stage1_status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "example": "claim-acb-roe-001"
          },
          "observation_id": {
            "type": "string",
            "nullable": true,
            "description": "Canonical observation asserted by this numeric claim."
          },
          "input_observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Accepted input observations for a derived numeric claim."
          },
          "formula_version": {
            "type": "string",
            "nullable": true,
            "description": "Versioned formula for a derived numeric claim."
          },
          "capability": {
            "type": "string",
            "enum": [
              "macro",
              "sector",
              "company",
              "synthesis"
            ]
          },
          "ticker": {
            "type": "string",
            "nullable": true,
            "example": "ACB"
          },
          "metric": {
            "type": "string",
            "nullable": true,
            "example": "ROE"
          },
          "period": {
            "type": "string",
            "nullable": true,
            "example": "2024"
          },
          "statement": {
            "type": "string"
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "factual_observation",
              "peer_comparison",
              "policy_transmission",
              "synthesis_evaluation"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "example": 0.98
          },
          "stage1_status": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected"
            ]
          },
          "stage2_critique_status": {
            "type": "string",
            "enum": [
              "sound",
              "revised",
              "limited"
            ]
          }
        }
      },
      "EvidenceTrailItem": {
        "type": "object",
        "required": [
          "metric",
          "source_doc"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "description": "Claim supported by this source record; derived claims may have one row per input observation."
          },
          "observation_id": {
            "type": "string",
            "description": "Exact canonical observation whose primary source and locator are shown."
          },
          "source_id": {
            "type": "string",
            "description": "Primary source record ID resolved from the observation."
          },
          "source_url": {
            "type": "string",
            "nullable": true,
            "description": "Original document URL when the reviewed source supplies one."
          },
          "evidence_id": {
            "type": "string",
            "example": "ev-acb-roe-2024"
          },
          "metric": {
            "type": "string",
            "example": "ROE"
          },
          "ticker": {
            "type": "string",
            "example": "ACB"
          },
          "period": {
            "type": "string",
            "example": "2024"
          },
          "value": {
            "type": "number",
            "example": 21.4
          },
          "source_doc": {
            "type": "string",
            "example": "Bao cao tai chinh hop nhat kiem toan 2024"
          },
          "table_locator": {
            "type": "string",
            "example": "Bao cao ket qua hoat dong kinh doanh"
          },
          "provenance_hash": {
            "type": "string",
            "example": "sha256-a1b2c3d4e5f6"
          }
        }
      },
      "BoundedRevisionSummary": {
        "type": "object",
        "required": [
          "rounds_executed",
          "max_rounds",
          "status"
        ],
        "properties": {
          "rounds_executed": {
            "type": "integer",
            "example": 1
          },
          "max_rounds": {
            "type": "integer",
            "example": 2
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "revised_and_passed",
              "accepted_with_limitations",
              "rejected"
            ],
            "example": "revised_and_passed"
          },
          "reason": {
            "type": "string",
            "example": "Do tre truyen dan lai suat huy dong sang NIM can bo sung thuyet minh BCTC quy 4."
          },
          "revised_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "company"
            ]
          },
          "synthesis_revised": {
            "type": "boolean",
            "description": "True only when a bounded revision changed the typed report-level synthesis artifact. It does not mark unchanged claims as revised.",
            "example": false
          }
        }
      },
      "AnalysisResponse": {
        "type": "object",
        "required": [
          "report_id",
          "status",
          "company_insights",
          "cross_level_critique"
        ],
        "properties": {
          "report_id": {
            "type": "string",
            "example": "rep-2024-acb-001"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "accepted_with_limitations",
              "error"
            ],
            "example": "completed"
          },
          "analysis_plan": {
            "$ref": "#/components/schemas/AnalysisPlan"
          },
          "macro_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MacroContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "sector_benchmark": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SectorBenchmark"
              },
              {
                "type": "null"
              }
            ]
          },
          "company_insights": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyInsight"
            }
          },
          "cross_level_critique": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CritiqueItem"
            }
          },
          "atomic_claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AtomicClaim"
            }
          },
          "evidence_trail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceTrailItem"
            }
          },
          "revision_summary": {
            "$ref": "#/components/schemas/BoundedRevisionSummary"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "synthesis_summary": {
            "type": "string",
            "description": "Grounded qualitative synthesis of the active specialist artifacts. New runtime responses populate this field; numeric facts remain in canonical claims and benchmark records."
          },
          "synthesis_supporting_claim_ids": {
            "type": "array",
            "description": "Unique final claim IDs, in candidate order, that support the exact synthesis artifact reviewed by the critic.",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "ObservableActivity": {
        "type": "object",
        "required": [
          "id",
          "description",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "DATA_RETRIEVAL",
              "VALIDATION",
              "INSIGHT_GENERATION",
              "REVISION"
            ]
          }
        }
      },
      "AnalysisSessionEvent": {
        "type": "object",
        "required": [
          "eventId",
          "sequence",
          "occurredAtMs",
          "type",
          "payload"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "example": "evt-001"
          },
          "sequence": {
            "type": "integer",
            "example": 1
          },
          "occurredAtMs": {
            "type": "integer",
            "example": 150
          },
          "type": {
            "type": "string",
            "enum": [
              "USER_REQUEST_CONFIRMED",
              "PLANNING_STARTED",
              "PLAN_CREATED",
              "SPECIALIST_INVOKED",
              "SPECIALIST_STARTED",
              "SPECIALIST_ACTIVITY",
              "SPECIALIST_OUTPUT_CREATED",
              "SPECIALIST_COMPLETED",
              "REVIEW_STARTED",
              "REVIEW_FEEDBACK_CREATED",
              "REVISION_REQUESTED",
              "REVISION_ACTIVITY",
              "REVISION_COMPLETED",
              "SYNTHESIS_STARTED",
              "SYNTHESIS_COMPLETED",
              "REPORT_READY",
              "RUN_BLOCKED"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Event-specific typed data dictionary"
          }
        }
      },
      "PeerBenchmarkRecord": {
        "type": "object",
        "description": "One accepted provider benchmark for one metric and period. Its requested/eligible sets and missing-member reasons apply only to this record, never to other metrics in the report.",
        "required": [
          "peer_universe_id",
          "requested_peer_entity_ids",
          "eligible_peer_entity_ids",
          "aggregation_method",
          "requested_denominator",
          "eligible_denominator",
          "missing_members",
          "metric_id",
          "benchmark_observation_id",
          "unit",
          "period",
          "period_basis",
          "reporting_scope",
          "value",
          "input_observation_ids"
        ],
        "properties": {
          "peer_universe_id": {
            "type": "string",
            "description": "Provider-declared peer universe identity."
          },
          "requested_peer_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Ordered requested member set defining benchmark identity and claim scope."
          },
          "eligible_peer_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Ordered members supplying accepted numeric input observations."
          },
          "aggregation_method": {
            "type": "string",
            "description": "Versioned provider aggregation method; currently peer_median_v1."
          },
          "requested_denominator": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of requested members."
          },
          "eligible_denominator": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of accepted numeric member inputs used by the aggregate."
          },
          "missing_members": {
            "type": "array",
            "description": "Requested members excluded from the numeric denominator, each with an explicit reason.",
            "items": {
              "type": "object",
              "required": [
                "entity_id",
                "reason"
              ],
              "properties": {
                "entity_id": {
                  "type": "string"
                },
                "observation_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "validation_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "benchmark_observation_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "period_basis": {
            "type": "string",
            "minLength": 1

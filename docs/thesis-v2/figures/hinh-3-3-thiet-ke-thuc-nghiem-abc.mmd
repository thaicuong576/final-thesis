flowchart TD
    subgraph IN ["Đầu vào dùng chung cho mọi cấu hình"]
        Q["12 câu hỏi<br/>T01–T10 phân tích · R1–R2 từ chối"]
        DB[("Snapshot Gold v5<br/>5 ngân hàng × 4 quý × 4 chỉ tiêu")]
        P["Kế hoạch tất định dùng chung<br/>(rules_only, cùng plan hash)"]
    end

    T["Công cụ phân tích tất định<br/>Fact + Dataset giống hệt nhau"]
    Q & DB & P --> T

    A["A — Tác tử đơn<br/>một lần lắp báo cáo từ mọi fact<br/>+ kiểm câu, không phản biện"]
    B["B — Phân cấp không phản biện<br/>chuyên viên viết câu → kiểm câu<br/>→ điều phối viên lắp báo cáo"]
    C["C — Phân cấp có phản biện<br/>như B + critic + tối đa 2 vòng<br/>sửa đổi có mục tiêu"]
    T --> A
    T --> B
    T --> C

    E["Chấm tất định<br/>hoàn thành · đúng số · truy vết nguồn<br/>độ phủ · xử lý thiếu dữ liệu · từ chối đúng<br/>câu bị loại · độ trễ · lượt gọi · token"]
    A & B & C --> E

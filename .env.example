# ==============================================================================
# Final Thesis Configuration Environment
# ==============================================================================

# Backend API Configuration
# Live Render Backend URL (Default Staging / Production)
VITE_API_BASE_URL=https://final-thesis-zgwt.onrender.com

# Local Backend Port (if running uvicorn locally)
PORT=8000
HOST=127.0.0.1

# Accepted analytical snapshot (read-only; provision explicitly)
SQLITE_DB_PATH=data/processed/gold-bank-2025-expanded-v5-evidence.sqlite
# Writable run history MUST use a different file from SQLITE_DB_PATH
ANALYSIS_RUNS_DB_PATH=data/runtime/analysis_runs.sqlite
# Required for Gold peer comparisons; absent scope authority leaves scope unknown
GOLD_SCOPE_AUTHORITY_PATH=data/evaluation/gold-v5-reporting-scope-authority-v1.json

# Linear Issue Tracking (Optional for Orchestrator Agents)
# LINEAR_API_KEY=lin_api_...

# OpenAI-Compatible LLM Provider (Codely Pixverse / OpenAI / DeepSeek / Ollama)
OPENAI_BASE_URL=https://superup.codelypixverse.com/v1
OPENAI_MODEL=deepseek-v4-pro-0813
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...

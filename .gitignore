# Local provider credentials and execution configuration.
.env
.env.*
!.env.example
config/local/
experiments/config/local/
**/provider-config.local.json
**/provider-config.local.*.json
secrets/

# Local experiment outputs; committed manifests and reports remain trackable.
outputs/provider/
experiments/outputs/provider/

# Local evidence stores, source documents, and generated experiment artifacts.
# These are large or machine-local inputs and are not part of the code-review
# handoff. Keep them available locally for reproducible runs.
data/
experiments/outputs/
/reports/
tmp/
.tmp-pdf-qa/
.codex-finalizer/
.agents/

# Frontend build and dependency artifacts.
frontend/node_modules/
frontend/dist/
.vercel/

# Binary/source artifacts that should not enter the source repository.
*.pdf
*.sqlite
*.sqlite3
*.db
~$*

# Python caches.
__pycache__/
*.py[cod]

# Multi-agent Git Worktrees
.worktrees/

# SQLite WAL temporary files
*.sqlite-wal
*.sqlite-shm

# Generated thesis Word output (rebuild with scripts/build_thesis_docx.py)
docs/thesis-v2/build/

# ER-8 Evaluation dry-run output
experiments/er8/dry-run/
experiments/er8/runs.sqlite

# Local tooling and editor state
.claude/
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.coverage
htmlcov/

# Stray outputs of ad-hoc local runs
prod_macro_results_*.json

# Development-process files and thesis document sources: kept locally, not published
/docs/
/.fleet/
/.agent/
/AGENTS.md
/PLAN.md
/PRODUCT.md
/scripts/build_thesis_docx.py
/scripts/apply_thesis_cover.py
/scripts/thesis_diagrams.py
/scripts/render_thesis_mermaid.py
/tests/test_build_thesis_docx.py
